  <!--[ <Common> | ManualAd ]-->
  <b:defaultmarkup type='Common'>
    <b:includable id='ManualAd.main'>
      <b:with value='data:links filter (l =&gt; data:amp.active ? l.name in [&quot;amp&quot;, &quot;AMP&quot;] : l.name in [&quot;noamp&quot;, &quot;NOAMP&quot;])' var='items'>
        <b:if cond='data:items.notEmpty'>
          <b:class cond='!data:amp.active' name='show-if-js'/>
          <b:with value='(data:items filter (l =&gt; l.target not in [&quot;https://&quot;, &quot;#&quot;, &quot;ad_code&quot;])).first.target ?: &quot;&quot;' var='content'>
            <b:include data='data:content' name='content'/>
          </b:with>

          <b:else/>
          <b:class name='hidden'/>
        </b:if>
      </b:with>
    </b:includable>

    <b:includable id='ManualAd.content'>
      <b:if cond='data:content'>
        <data:content/>

        <b:else/>
        <!--[ Blank ad ]-->
        <div class='adB' expr:data-text='data:messages.adsGoHere + &quot; (&quot; + data:title + &quot;)&quot;'>
          <b:class cond='data:widget.sectionId == &quot;sec_Side_Sticky&quot;' name='h240'/>
        </div>
      </b:if>
    </b:includable>
  </b:defaultmarkup>
