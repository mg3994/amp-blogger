          <b:attr cond='data:caption' expr:value='data:caption' name='data-caption'/>
        </div>
      </b:if>

      <b:if cond='data:link'>
        <a class='sldL' expr:aria-label='data:title' expr:href='data:link' expr:title='data:title' rel='nofollow noreferrer noopener' target='_blank'/>
      </b:if>
    </b:includable>

    <!--[ Index title ]-->
    <b:includable id='titlePost'>
      <div class='blogT'>
        <b:class cond='data:view.isHomepage' name='hm'/>
        <b:if cond='data:view.isHomepage'>

          <!--[ Change <data:messages.latestPosts/> to replace 'Latest Posts' with your special text ]-->
          <h2 class='title dt'><data:messages.latestPosts/></h2>

          <b:else/>
          <div class='t'>
            <b:class cond='data:view.search or data:view.isArchive and data:view.url.canonical != path(data:blog.homepageUrl.canonical, &quot;search&quot;)' name='srch'/>
            <b:if cond='data:view.search.label'>
              <span class='hm' expr:data-text='data:messages.home'/><data:blog.pageName/>

              <b:elseif cond='data:view.search.query'/>
              <span expr:data-text='data:messages.search + &quot;:&quot;'/><data:view.search.query/>

              <b:elseif cond='data:view.isArchive'/>
              <span expr:data-text='data:messages.blogArchive + &quot;:&quot;'/><data:blog.pageName/>

              <b:else/>

              <!--[ Change all <data:messages.posts/> to replace 'Posts' with your special text ]-->
              <span class='hm' expr:data-text='data:messages.home'/><data:messages.posts/>

            </b:if>
          </div>
        </b:if>
      </div>
    </b:includable>

    <!--[ Preloader ]-->
    <b:includable id='preloader'>
      <div class='pldW' id='preloader'><div class='ldrHt'/></div>
      <script>/*<![CDATA[*/ "use strict";((window,document)=>{const element=document.getElementById('preloader');element.classList.add('e');element.addEventListener('transitionend',(e)=>{if(e.propertyName==='opacity'&&getComputedStyle(element).opacity==='0'){element.remove()}});document.addEventListener('DOMContentLoaded',()=>setTimeout(()=>element.classList.add('h'),1500))})(window,document); /*]]>*/</script>
    </b:includable>

    <!--[ Thumbnail items ]-->
    <b:includable id='thumbnail-items'>
      <b:with value='data:story.status and data:story.type != 1 and snippet(data:post.url.canonical) contains &quot;story.html&quot;' var='isPostStory'>
        <div class='tfxM T'>
          <div class='tfxC'>
            <!--[ Quick edit ]-->
            <b:include cond='!data:view.isPreview and data:vars.quickedit_status == &quot;2px&quot; and data:vars.quickedit_editPost == &quot;2px&quot;' name='thumb-quickedit'/>
          </div>
          <div class='tfxC'>
            <b:if cond='data:post.labels any (label =&gt; label.name in [ &quot;Sponsored&quot; ])'>
              <!--[ Sponsored tag ]-->
              <b:include name='postSponsored'/>

              <b:elseif cond='data:post.labels any (label =&gt; label.name in [ &quot;Product&quot; ])'/>
              <!--[ Product tag ]-->
              <b:include name='postProduct'/>

              <!--[ Story tag ]-->
              <b:elseif cond='data:isPostStory'/>
              <b:include name='postStory'/>

              <b:elseif cond='data:widgets.Blog.first.allBylineItems.comments and data:post.allowComments and data:post.numberOfComments &gt; 0 '/>
              <!--[ Comments count ]-->
              <b:include name='postCommentsLinks'/>
            </b:if>

            <!--[ Post views ]-->
            <b:if cond='!data:isPostStory and !data:amp.active and !data:view.isPreview and data:vars.views_status == &quot;2px&quot; and data:widgets.LinkList61'>
              <span class='pV fb-views show-if-js' expr:data-abbreviate='data:vars.views_abbreviate == &quot;2px&quot; ? true : false' expr:data-id='data:post.id' expr:data-watch='data:vars.views_watch == &quot;2px&quot; ? true : false'>
                <b:include name='svg.eye'/>
              </span>
            </b:if>

            <!--[ Post bookmark ]-->
            <b:include cond='!data:view.isPreview and !data:amp.active and data:widgets.LinkList02' name='thumb-bookmark'/>
          </div>
        </div>
        <div class='tfxM B'>
          <div class='tfxC'>
            <!--[ Post author ]-->
            <b:include cond='data:widgets.Blog.first.allBylineItems.author and data:vars.thumbnail_author == &quot;2px&quot;' name='postAuthor-thumbnail'/>
          </div>
        </div>
      </b:with>
    </b:includable>

    <!--[ Quick Edit on Thumbnails ]-->
