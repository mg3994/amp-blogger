        <a class='cmnt' expr:aria-label='data:messages.comments' expr:data-text='data:post.numberOfComments' expr:href='fragment(data:post.url.canonical, &quot;comment&quot;)'>
          <b:class cond='data:view.isSingleItem' name='tIc'/>
          <b:include name='chat-icon'/>
        </a>
      </b:if>
    </b:includable>

    <b:includable id='postCommentsLabel'>
      <b:if cond='data:post.allowComments and (data:view.isMultipleItems ? data:post.numberOfComments &gt; 0 : true) and data:vars.comments_blogger == &quot;2px&quot;'>
        <a class='cmnt' expr:aria-label='data:messages.comments' expr:href='data:view.url.canonical != data:post.url.canonical ? fragment(data:post.url.canonical, &quot;comment&quot;) : &quot;#comment&quot;'>
          <b:class cond='data:view.isSingleItem' name='tIc'/>
          <b:attr cond='data:view.isSingleItem' name='role' value='button'/>
          <b:attr cond='data:post.numberOfComments &gt; 0' expr:value='data:post.numberOfComments' name='data-text'/>
          <b:include name='chat-icon'/>
        </a>
      </b:if>
    </b:includable>

