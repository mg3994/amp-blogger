    <!--[ Image ]-->
    <b:includable id='image-auto' var='input'>
      <b:with value='data:input.width and (data:input.height or data:input.ratio) ? resizeImage(data:input.image, data:input.width, (data:input.height ? data:input.width + &quot;:&quot; + data:input.height : data:input.ratio)) : data:input.image' var='a'>
        <b:with value='data:a.width and data:a.height ? 1 : (data:input.width and data:input.height ? 2 : 0)' var='b'>
          <b:with value='(data:input.protocol != false and data:a not contains &quot;http://&quot; and data:a not contains &quot;https://&quot; ? &quot;https:&quot; : &quot;&quot;) + data:a' var='c'>
            <b:with value='data:input.placeholder and data:input.protocol != false and data:input.placeholder not contains &quot;http://&quot; and data:input.placeholder not contains &quot;https://&quot; ? &quot;https:&quot; + data:input.placeholder : data:input.placeholder' var='d'>
              <b:with value='{ src: data:c, width: (data:b == 1 ? data:a.width : (data:b == 2 ? data:input.width : false)), height: (data:b == 1 ? data:a.height : (data:b == 2 ? data:input.height : false)), alt: data:input.alt, title: data:input.title, class: data:input.class, placeholder: data:d, noOptimization: data:input.noOptimization, noBrowserLazy: data:input.noBrowserLazy, noLibraryLazy: data:input.noLibraryLazy }' var='image'>

                <b:if cond='data:amp.active'>
                  <b:comment><!--[ AMP image ]--></b:comment>
                  <amp-img expr:src='data:image.src' layout='intrinsic'>
                    <b:class cond='data:image.class' expr:name='data:image.class'/>
                    <b:attr cond='data:image.width' expr:value='data:image.width' name='width'/>
                    <b:attr cond='data:image.height' expr:value='data:image.height' name='height'/>
                    <b:attr cond='data:image.alt' expr:value='data:image.alt' name='alt'/>
                    <b:attr cond='data:image.title' expr:value='data:image.title' name='title'/>
                  </amp-img>

                  <b:elseif cond='!data:image.noOptimization and data:vars.optimization_imageLoading == &quot;3px&quot; and !data:image.noLibraryLazy'/>
                  <b:comment><!--[ Lazyload (Library) image ]--></b:comment>
                  <img class='lazyload show-if-js' expr:data-src='data:image.src' expr:src='data:image.placeholder ? data:image.placeholder : &quot;data:image/png;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=&quot;'>
                    <b:class cond='data:image.class' expr:name='data:image.class'/>
                    <b:attr cond='data:image.width' expr:value='data:image.width' name='width'/>
                    <b:attr cond='data:image.height' expr:value='data:image.height' name='height'/>
                    <b:attr cond='data:image.alt' expr:value='data:image.alt' name='alt'/>
                    <b:attr cond='data:image.title' expr:value='data:image.title' name='title'/>
                  </img>
                </b:if>

                <b:comment><!--[ Normal / Lazyload (Browser) / Noscript image ]--></b:comment>
                <b:tag cond='data:amp.active or (!data:image.noOptimization and data:vars.optimization_imageLoading == &quot;3px&quot; and !data:image.noLibraryLazy)' name='noscript'>
                  <img expr:src='data:image.src'>
                    <b:class cond='data:image.class' expr:name='data:image.class'/>
                    <b:attr cond='!data:image.noOptimization and data:vars.optimization_imageLoading == &quot;2px&quot; and !data:image.noBrowserLazy' name='loading' value='lazy'/>
                    <b:attr cond='data:image.width' expr:value='data:image.width' name='width'/>
                    <b:attr cond='data:image.height' expr:value='data:image.height' name='height'/>
                    <b:attr cond='data:image.alt' expr:value='data:image.alt' name='alt'/>
                    <b:attr cond='data:image.title' expr:value='data:image.title' name='title'/>
                  </img>
                </b:tag>

              </b:with>
            </b:with>
          </b:with>
        </b:with>
      </b:with>
    </b:includable>

    <!--[ Slider image ]-->
    <b:includable id='carouselWidget' var='slides'>
      <b:class name='sldA'/>
      <b:attr expr:value='data:widget.instanceId' name='data-i'/>

      <b:include data='{ class: &quot;sldI&quot;, image: data:sourceUrl, width: (data:blog.isMobileRequest ? 600 : 1080), height: (data:blog.isMobileRequest ? 240 : 432), alt: data:title, placeholder: (resizeImage(data:sourceUrl, 35, &quot;5:2&quot;) != data:sourceUrl ? resizeImage(data:sourceUrl, 35, &quot;5:2&quot;) : false), noBrowserLazy: true }' name='image-auto'/>

      <b:if cond='data:title not contains &quot;[NoTitle]&quot;'>
