  <!--[ <Common> | LinkList ]-->
  <b:defaultmarkup type='Common'>
    <b:includable id='LinkList.main'>
      <b:if cond='data:title contains &quot;[Ad]&quot;'>
        <b:if cond='((data:title contains &quot;[Mobile]&quot; and data:blog.isMobileRequest) or (data:title contains &quot;[Desktop]&quot; and !data:blog.isMobileRequest) or (data:title not contains &quot;[Mobile]&quot; and data:title not contains &quot;[Desktop]&quot;))'>
          <b:include name='ManualAd.main'/>
          <b:else/>
          <b:class name='hidden'/>
        </b:if>

        <b:else/>
        <b:include cond='data:title not contains &quot;[NoTitle]&quot;' name='widget-title'/>
        <b:include name='content'/>
      </b:if>
    </b:includable>

    <b:includable id='LinkList.content'>
      <b:if cond='data:title contains &quot;[Ad]&quot;'>
        <b:include name='ManualAd.content'/>

        <b:else/>
        <ul>
          <b:loop values='data:links' var='link'>
            <li><a expr:href='data:link.target'><data:link.name/></a></li>
          </b:loop>
        </ul>
      </b:if>
    </b:includable>

    <b:includable id='LinkList.get' var='c'><b:if cond='data:c and (data:c.links ?: data:links) and (data:c.name or data:c.names)'><b:with value='(data:c.links ?: data:links) filter (l =&gt; (l.name == data:c.name or l.name in (data:c.names ?: [])) and (data:l.target in (data:c.include ?: [data:l.target])) and (data:l.target not in (data:c.exclude ?: [&quot;https://&quot;, &quot;#&quot;])))' var='valids'><b:if cond='data:valids.notEmpty'><b:loop index='i' values='data:valids' var='l'><b:with value='data:l.target' var='value'><b:with value='data:c.escape == &quot;json&quot; ? data:value.jsonEscaped : (data:c.escape == &quot;html&quot; ? data:value.escaped : (data:c.escape == &quot;css&quot; ? data:value.cssEscaped : (data:c.escape == &quot;js&quot; ? data:value.jsEscaped : data:value)))' var='escaped'><b:if cond='data:i == 0'><b:if cond='data:c.attribute'><b:attr expr:name='data:c.attribute' expr:value='data:escaped.escaped'/><b:elseif cond='data:c.class'/><b:class expr:name='data:escaped.escaped'/><b:else/><data:escaped/></b:if></b:if></b:with></b:with></b:loop><b:elseif cond='data:c.default.length'/><b:with value='data:c.escape == &quot;json&quot; ? data:c.default.jsonEscaped : (data:c.default == &quot;html&quot; ? data:c.default.escaped : (data:c.escape == &quot;css&quot; ? data:c.default.cssEscaped : (data:c.escape == &quot;js&quot; ? data:c.default.jsEscaped : data:c.default)))' var='escaped'><b:if cond='data:c.attribute'><b:attr expr:name='data:c.attribute' expr:value='data:escaped.escaped'/><b:elseif cond='data:c.class'/><b:class expr:name='data:escaped.escaped'/><b:else/><data:escaped/></b:if></b:with></b:if></b:with></b:if></b:includable>

    <b:includable id='LinkList.json' var='c'><b:if cond='data:c and (data:c.links or data:links)'><b:with value='(data:c.links ?: data:links) filter (l =&gt; (l.name in (data:c.include ?: [l.name])) and (l.name not in (data:c.exclude ?: [])))' var='filtered'><b:with value='data:filtered filter (l =&gt; (l.target in (data:c.includeValues ?: [l.target])) and (l.target not in (data:c.excludeValues ?: [])))' var='valids'>{<b:loop index='i' values='data:valids' var='l'>&quot;<data:l.name.jsonEscaped/>&quot;:&quot;<data:l.target.jsonEscaped/>&quot;<b:if cond='data:i &lt; (data:valids.length - 1)'>,</b:if></b:loop>}</b:with></b:with></b:if></b:includable>
